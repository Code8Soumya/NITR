{
  "expo": {
    "name": "NITR HUB",
    "slug": "nitr-hub",
    "scheme": "nitrhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "package": "com.nitrhub.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
